{
  "name": "bengtipredictor",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "fetch": "node scripts/fetch-league.mjs",
    "import-replays": "node scripts/import-replay-fantasy.mjs",
    "replay": "node scripts/replay-stats.mjs",
    "replays": "node scripts/replay-batch.mjs",
    "leagues": "node scripts/list-leagues.mjs",
    "discover": "node scripts/discover.mjs",
    "discover-sources": "node scripts/discover-source-events.mjs",
    "prepare-sources": "node scripts/prepare-origin-sources.mjs",
    "recover-sources": "node scripts/recover-origin-sources.mjs",
    "validate": "tsc -p tsconfig.validate.json && node scripts/validate.mjs",
    "train": "node scripts/build-training.mjs",
    "simulate": "tsc -p tsconfig.validate.json && node scripts/simulate.mjs",
    "study": "tsc -p tsconfig.validate.json && node scripts/study.mjs",
    "explain": "tsc -p tsconfig.validate.json && node scripts/explain.mjs",
    "persistence": "node scripts/persistence.mjs",
    "audit-data": "node scripts/audit-data.mjs",
    "test": "tsc -p tsconfig.validate.json && node --test tests/*.test.mjs",
    "prepare-ti": "node scripts/prepare-ti.mjs",
    "compare-models": "node scripts/compare-models.mjs",
    "benchmark-policy": "tsc -p tsconfig.validate.json && node scripts/benchmark-policy.mjs"
  },
  "dependencies": {
    "next": "^16.3.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/node": "20.14.12",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "typescript": "5.5.4"
  },
  "description": "Fantasy calculator and bracket predictor for The International, built on real OpenDota match data."
}
